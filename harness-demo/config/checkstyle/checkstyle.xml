<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="severity" value="error"/>

    <!--
        口头约定机械化规则总表：

        1. "方法要短"
           机械规则：单方法 <= 50 行
           实现方式：Checkstyle MethodLength

        2. "文件要短"
           机械规则：单文件 <= 300 行
           实现方式：Checkstyle FileLength

        3. "日志要规范"
           机械规则：禁止 System.out.println / printStackTrace
           实现方式：Checkstyle RegexpSinglelineJava

        4. "HTTP 调用要统一"
           机械规则：禁止裸 RestTemplate / HttpURLConnection
           实现方式：ArchUnit 自定义规则

        5. "Controller 要纯"
           机械规则：Controller 不得直接调 Mapper
           实现方式：ArchUnit 分层规则

        6. "依赖要构造器注入"
           机械规则：禁止字段级 @Autowired
           实现方式：ArchUnit 注解检查

        7. "不要污染全局"
           机械规则：禁止 public static 非 final 字段
           实现方式：SpotBugs MS_* 规则族

        8. "测试要充分"
           机械规则：行覆盖率 >= 80%
           实现方式：JaCoCo coverage check

        9. "锁定构建工具版本"
           机械规则：Maven >= 3.6.3，JDK = 1.8
           实现方式：maven-enforcer-plugin
    -->

    <module name="FileLength">
        <property name="max" value="300"/>
        <message key="maxLen.file"
                 value="❌ 文件超过 300 行。
✅ FIX: 拆分为更小的类，把辅助方法移至 *Helper 或 infrastructure。
📖 See: docs/conventions/file-size.md"/>
    </module>

    <module name="RegexpSinglelineJava">
        <property name="format" value="System\.out\.println"/>
        <property name="message"
                  value="❌ 禁止 System.out.println。
✅ FIX: private static final Logger log = LoggerFactory.getLogger(X.class);
📖 See: docs/conventions/logging.md"/>
    </module>

    <module name="RegexpSinglelineJava">
        <property name="format" value="\.printStackTrace\(\)"/>
        <property name="message"
                  value="❌ 禁止 e.printStackTrace()。
✅ FIX: log.error(&quot;context message&quot;, e);
📖 See: docs/conventions/logging.md"/>
    </module>

    <module name="TreeWalker">
        <module name="MethodLength">
            <property name="max" value="50"/>
            <property name="countEmpty" value="false"/>
            <message key="maxLen.method"
                     value="❌ 方法超过 50 行。
✅ FIX: 抽取私有方法或将职责下沉到 Service / Domain。
📖 See: docs/conventions/method-size.md"/>
        </module>
    </module>
</module>
